# окружение
.venv/
__pycache__/
*.pyc
.env

# веса и большие артефакты — не в git
models/**
!models/README.md
*.onnx
*.gguf
*.pt
*.pth
*.safetensors
*.bin

# аудио-дампы и результаты прогонов: в git — сводки .md и сырые CSV/JSON до ~1 МБ
# (данные для статей; раньше жили только в WSL). Аудио и большие дампы — нет.
*.wav
*.mp3
research/**/results/**
!research/**/results/.gitkeep
!research/**/results/*.md
!research/**/results/*.csv
!research/**/results/*.json
research/**/data/**

# персона: датасет по умолчанию приватный (см. persona/README.md)
persona/dataset/**
!persona/dataset/README.md

# локальное
*.log
.DS_Store
