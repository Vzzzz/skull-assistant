[Unit]
ConditionPathExists=!/mnt/c/Users/valer/.skull-maintenance
PartOf=skull.target
Description=Skull: speech-to-text (faster-whisper)
After=skull-wakeword.service

[Service]
ExecStart=@REPO@/.venv/bin/python @REPO@/services/stt/transcriber.py
Restart=on-failure
RestartSec=2
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=skull.target
