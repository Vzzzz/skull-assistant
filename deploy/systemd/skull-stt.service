[Unit]
ConditionPathExists=!@MAINT_FLAG@
PartOf=skull.target
Description=Skull: speech-to-text (GigaAM v3 CTC, sherpa-onnx) + voice id
After=skull-wakeword.service

[Service]
ExecStart=@REPO@/.venv/bin/python @REPO@/services/stt/transcriber.py
Restart=on-failure
RestartSec=2
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=skull.target
