[Unit]
ConditionPathExists=!@MAINT_FLAG@
PartOf=skull.target
Description=Skull: brain (llama-server)
# skull-embed is not wanted here: in mode B it is evacuated (services/embed manifest), the dispatcher owns it (T-044)
Wants=skull-llm.service
After=skull-stt.service skull-llm.service skull-embed.service

[Service]
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/python @REPO@/services/brain/responder.py
Restart=on-failure
RestartSec=5
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=skull.target
