[Unit]
ConditionPathExists=!/mnt/c/Users/valer/.skull-maintenance
PartOf=skull.target
Description=Skull: brain (llama-server)
Wants=skull-llm.service skull-embed.service
After=skull-stt.service skull-llm.service skull-embed.service

[Service]
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/python @REPO@/services/brain/responder.py
Restart=on-failure
RestartSec=5
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=skull.target
